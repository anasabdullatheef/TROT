# =============================================================================
# CROSS-EXCHANGE ARBITRAGE BOT - Configuration
# =============================================================================
# Copy this file to .env and fill in your API keys

# =============================================================================
# BINANCE API
# =============================================================================
# Create keys at: https://www.binance.com/en/my/settings/api-management
# Required permissions: Enable Spot Trading
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# =============================================================================
# BYBIT API
# =============================================================================
# Create keys at: https://www.bybit.com/app/user/api-management
# Required permissions: Enable Spot Trading
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here

# =============================================================================
# OKX API
# =============================================================================
# Create keys at: https://www.okx.com/account/my-api
# Required permissions: Enable Trade
OKX_API_KEY=your_okx_api_key_here
OKX_API_SECRET=your_okx_api_secret_here
OKX_PASSPHRASE=your_okx_passphrase_here

# =============================================================================
# TELEGRAM NOTIFICATIONS (Optional)
# =============================================================================
# 1. Create a bot with @BotFather and get the token
# 2. Get your chat ID by sending /start to @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
